# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Secret used to sign session cookies (any long random string)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Admin role ─────────────────────────────────────────────────
ADMIN_EMAILS=             # Comma-separated emails that get the admin role on sign-in
                          # e.g. ADMIN_EMAILS=you@edam.in,partner@edam.in

# ── Optional integrations (site works without these) ───────────
RAZORPAY_KEY_ID=          # Razorpay key id — enables online UPI/card checkout
RAZORPAY_KEY_SECRET=      # Razorpay secret — verifies payments + webhooks
MAIL_WEBHOOK_URL=         # POST endpoint that delivers queued notification mail
                          # (sign-in codes travel through this outbox; without it,
                          #  codes can be read from the admin notifications panel)
